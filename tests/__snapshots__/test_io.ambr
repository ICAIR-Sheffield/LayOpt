# ---
# name: test_dict_to_df[realistic]
  '''
               timestamp      problem_name width height n_load_points n_patterns_total n_patterns_active load_large load_small iterations final_volume n_members_final n_nodes n_ground_structure cpu_time_setup cpu_time_solve primal_method                  notes
  0  2026-04-08 13:57:09  short cantilever     3      6             1                2                 1       50.0        5.0          2        300.0              81      28                251       0.004292       0.043679   load_factor  short cantilever test
  '''
# ---
# name: test_write_config[alternative filename]
  '''
  base_dir: .  # Base directory
  output_dir: output # Path to save the output to, default is './output/'.
  log_level: info # Verbosity used in logging
  cores: 2 # Cores to run optimisation on in parallel
  width: 3 # Width of structure
  height: 3 # Height of structure
  steps: 1.0 # Steps to generate nodes
  stress_tensile: 1.0 # Tensile yield stress
  stress_compressive: 1.0 # Compressive yield stress
  youngs_modulus: 1.0 # Young's modulus (E)
  avg_deflection_limit: -1.0 # Limit on average load deflection for compliance optimization (leave negative for plastic limit solution)
  joint_cost: 0.0 # Joint cost
  loaded_points: # Loaded Points
    - [1, 0]
    - [2, 0]
  load_direction: [0.0, -1.0] # Loaded direction
  load_large: 50.0 # Large load
  load_small: 5.0 # Small load
  max_length: 18.0 # Maximum member length
  max_length_initial_ground_structure: 1.5 # Threshold for marking a potential member as active in the initial ground structure
  support_points: # Support points in form [x_coord, y_coord, restrain_x, restrain_y] (true=fixed, false=free for restrain_x/restrain_y)
    - [0.0, 0.0, true, true]
    - [3.0, 3.0, true, true]
  member_area_filtering: 0.001 # Fraction of maximum member area for output threshold
  cvxpy: # CVXPY options. See https://www.cvxpy.org/tutorial/solvers/index.html?h=solve#choosing-a-solver for further details on solver options
    solver: clarabel
  filter_levels: [1.0] # List of values to filter by if empty no filtering is performed
  primal_method: load_factor # Primal method
  problem_name: '' # Description of the problem being solved
  csv_filename: results.csv # Filename to save results to, if left as `results.csv` will have YYYY-MM-DD-hhmmss added
  notes: '' # Notes to add to the model
  plotting: # Plotting options
    run: false
    bar_thickness: 0.3
    dpi: 1200
  '''
# ---
